  flutterAmplitude: 0.16
  flutterCycles: 5
  finalLine: Some things are not meant to be held forever.
  narration:
  - atSeconds: 3
    duration: 6
    text: You learned the sky from one small branch.
    voice: {fileID: 8300000, guid: 0a259b480f7d8284393ed8b267ad555e, type: 3}
  - atSeconds: 11
    duration: 6
    text: 'The rain. The warm afternoons.

      The familiar voice beneath you.'
    voice: {fileID: 8300000, guid: dfb56a01d515c724989a472c0a3155f4, type: 3}
  - atSeconds: 20
    duration: 6
    text: 'When the wind came, you held on.

      Again, and again.'
    voice: {fileID: 8300000, guid: c07edfcbcc3fd374e8d9d58753e52d12, type: 3}
  - atSeconds: 29
    duration: 6
    text: 'You thought leaving would undo

      everything that made this home.'
    voice: {fileID: 8300000, guid: 4ef97e9839af1c94ca3b8e342403f742, type: 3}
  - atSeconds: 39
    duration: 6
    text: 'But the branch has not forgotten.

      And you have not failed it.'
    voice: {fileID: 8300000, guid: 82e5c10939363c54c883478d374b15bb, type: 3}
  - atSeconds: 49
    duration: 6
    text: 'What held you is still part of you.

      Even now. Even here.'
    voice: {fileID: 8300000, guid: 0eba7c0ed7d56d345a368a20aa03f6aa, type: 3}
